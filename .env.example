# Optional: full origin of your API (no trailing slash). If unset, use relative paths
# and add "proxy": "http://localhost:3001" to package.json for local dev.
REACT_APP_API_URL=http://localhost:3001

# Set to true in dev to behave like production (no merged mock data; notifications/recent from API).
# Production builds always use the backend for dynamic data (see src/config/dataMode.js).
# REACT_APP_USE_BACKEND_DATA=true
